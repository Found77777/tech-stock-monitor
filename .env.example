APP_NAME=A-Share Tech Stock Monitor
APP_ENV=dev
DATABASE_URL=sqlite:///data/tech_monitor.db
DATA_SOURCE_PROVIDER=sina
TUSHARE_TOKEN=
SCHEDULER_TIMEZONE=Asia/Shanghai
MIN_AMOUNT=50000000

USE_MOCK_DATA=false
REAL_DATA_SOURCE=sina
HISTORY_DATA_SOURCE=sina
ENABLE_DATA_SOURCE_FALLBACK=true
# options: efinance | sina | akshare | mock

# --- AI Agent ---
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_HTTP_PROXY=http://127.0.0.1:7890
AGENT_NEWS_SOURCES=sina,eastmoney,cninfo,baidu,rss
AGENT_ENABLED=false

ENABLE_FACTOR_REDUNDANCY_ADJUSTMENT=false

CAPITAL_FLOW_RETRY=3
CAPITAL_FLOW_SLEEP_MIN=10.0
CAPITAL_FLOW_SLEEP_MAX=20.0

CAPITAL_FLOW_SOURCE=sina
CAPITAL_FLOW_ALLOW_PROXY=false
CAPITAL_FLOW_CACHE_ENABLED=true
